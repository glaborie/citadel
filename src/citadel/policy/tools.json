{
  "version": 2,
  "comment": "Tool catalog. Classification is enforced by policy, never by a SKILL.md. 'command' links a tool to a command allowlist entry; a tool without one is authorisable but not executable. See docs/security/tool-tiers.md and docs/adr/ADR-023.md.",
  "tiers": {
    "T0": "allow",
    "T1": "requires_approval",
    "T2": "deny"
  },
  "tools": {
    "inspect_containers": {
      "tier": "T0",
      "agent": "docker",
      "command": "docker.ps",
      "params": []
    },
    "read_logs": {
      "tier": "T0",
      "agent": "docker",
      "command": "docker.compose.logs",
      "params": [{ "name": "service", "in": "positional", "max_length": 64 }]
    },
    "get_service_health": {
      "tier": "T0",
      "agent": "docker",
      "command": "docker.ps",
      "params": []
    },
    "restart_service": {
      "tier": "T1",
      "agent": "docker",
      "command": "docker.compose.restart",
      "params": [{ "name": "service", "in": "positional", "max_length": 64, "required": true }]
    },
    "search_code": {
      "tier": "T0",
      "agent": "github",
      "command": null,
      "params": []
    },
    "get_pr_status": {
      "tier": "T0",
      "agent": "github",
      "command": "gh.pr.list",
      "params": [{ "name": "repo", "in": "flag", "flag": "--repo", "max_length": 128 }]
    },
    "open_remediation_pr": {
      "tier": "T1",
      "agent": "github",
      "command": null,
      "params": []
    },
    "delete_volume": { "tier": "T2", "agent": "docker", "command": null, "params": [] },
    "force_push": { "tier": "T2", "agent": "github", "command": null, "params": [] }
  }
}
