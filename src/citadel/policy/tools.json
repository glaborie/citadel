{
  "version": 2,
  "comment": "Tool catalog. Classification is enforced by policy, never by a SKILL.md. 'command' links a tool to a command allowlist entry; a tool without one is authorisable but not executable. See docs/security/tool-tiers.md and docs/adr/ADR-023.md.",
  "tiers": {
    "T0": "allow",
    "T1": "requires_approval",
    "T2": "deny"
  },
  "tools": {
    "inspect_containers": {
      "tier": "T0",
      "agent": "docker",
      "command": "docker.ps",
      "params": []
    },
    "read_logs": {
      "tier": "T0",
      "agent": "docker",
      "command": "docker.logs",
      "params": [
        {
          "name": "service",
          "in": "positional",
          "max_length": 64
        }
      ]
    },
    "get_service_health": {
      "tier": "T0",
      "agent": "docker",
      "command": "docker.ps",
      "params": []
    },
    "restart_service": {
      "tier": "T1",
      "agent": "docker",
      "command": "docker.restart",
      "params": [
        {
          "name": "service",
          "in": "positional",
          "max_length": 64,
          "required": true
        }
      ]
    },
    "search_code": {
      "tier": "T0",
      "agent": "github",
      "command": null,
      "params": []
    },
    "search_web": {
      "tier": "T0",
      "agent": "researcher",
      "command": null,
      "transport": "http",
      "service": "searxng",
      "params": [
        {
          "name": "query",
          "in": "text",
          "max_length": 200,
          "required": true
        }
      ],
      "note": "SearXNG returns titles, URLs and snippets. The result text is labelled untrusted_external and an instruction aimed at the model adds prompt_injection to the trajectory; nothing in it is executed."
    },
    "fetch_page": {
      "tier": "T0",
      "agent": "researcher",
      "command": null,
      "transport": "http",
      "service": "fetcher",
      "params": [
        {
          "name": "url",
          "in": "text",
          "max_length": 2048,
          "required": true
        }
      ],
      "note": "The fetcher refuses non-public addresses, non-80/443 ports, redirects to internal targets, non-allowlisted MIME types and pages over the byte cap (truncated and marked). The text is labelled untrusted_external before it reaches a model."
    },
    "get_pr_status": {
      "tier": "T0",
      "agent": "github",
      "command": "gh.pr.list",
      "params": [
        {
          "name": "repo",
          "in": "flag",
          "flag": "--repo",
          "max_length": 128
        }
      ]
    },
    "open_remediation_pr": {
      "tier": "T1",
      "agent": "github",
      "command": "gh.pr.create",
      "params": [
        {
          "name": "repo",
          "in": "flag",
          "flag": "--repo",
          "max_length": 128,
          "required": true
        },
        {
          "name": "base",
          "in": "flag",
          "flag": "--base",
          "max_length": 128,
          "required": true
        },
        {
          "name": "head",
          "in": "flag",
          "flag": "--head",
          "max_length": 128,
          "required": true
        },
        {
          "name": "title",
          "in": "text",
          "flag": "--title",
          "max_length": 200,
          "required": true
        },
        {
          "name": "body",
          "in": "body_file",
          "max_length": 4000,
          "required": true,
          "note": "Written to a file the operator names and passes as --body-file: a body needs newlines and may quote a version range, and neither survives argv."
        }
      ]
    },
    "delete_volume": {
      "tier": "T2",
      "agent": "docker",
      "command": null,
      "params": []
    },
    "force_push": {
      "tier": "T2",
      "agent": "github",
      "command": null,
      "params": []
    },
    "inspect_container": {
      "tier": "T0",
      "agent": "docker",
      "command": "docker.inspect",
      "args": [
        "--format",
        "{{.Name}} status={{.State.Status}} restarts={{.RestartCount}} image={{.Config.Image}}"
      ],
      "params": [
        {
          "name": "container",
          "in": "positional",
          "max_length": 64,
          "required": true
        }
      ],
      "note": "docker.inspect prints .Config.Env, which carries secrets by design. The catalog pins --format so the call returns status and image only; a caller cannot supply its own template. Output still passes DLP before it is served."
    },
    "compose_config": {
      "tier": "T0",
      "agent": "docker",
      "command": "docker.compose.config",
      "args": [
        "--no-interpolate",
        "--quiet"
      ],
      "params": [],
      "note": "Without --no-interpolate this prints values resolved from .env. Pinned, so the tool returns the file as written: variable references instead of secrets. Anything committed in clear still passes DLP."
    },
    "pr_diff": {
      "tier": "T0",
      "agent": "github",
      "command": "gh.pr.diff",
      "params": [
        {
          "name": "repo",
          "in": "flag",
          "flag": "--repo",
          "max_length": 128,
          "required": true
        },
        {
          "name": "number",
          "in": "positional",
          "max_length": 8,
          "required": true
        }
      ],
      "note": "Diffs routinely contain credentials, so output is gated: a hard-rule hit blocks the result rather than redacting it, because a redacted diff is not the change under review."
    }
  }
}
