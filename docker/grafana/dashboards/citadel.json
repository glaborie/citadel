{
  "uid": "citadel-controls",
  "title": "Citadel controls",
  "tags": ["citadel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Runs by outcome",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(citadel_runs_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Model calls by outcome",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(citadel_model_calls_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens by kind",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(citadel_model_tokens_total[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Model cost: reported USD vs unreported calls",
      "description": "Reported cost and calls whose cost the gateway did not report. 'Free' and 'unknown' are different answers, so neither series may be dropped.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(citadel_model_cost_usd_total[$__rate_interval]))",
          "legendFormat": "reported USD"
        },
        {
          "refId": "B",
          "expr": "sum(increase(citadel_model_cost_unreported_total[$__rate_interval]))",
          "legendFormat": "unreported calls"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DLP blocks by surface and reason",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (surface, reason) (increase(citadel_dlp_blocks_total[$__rate_interval]))",
          "legendFormat": "{{surface}} {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Policy denials by rule",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (increase(citadel_policy_denials_total[$__rate_interval]))",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache lookups by result",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(citadel_cache_lookups_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Approval wait, p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, decision) (rate(citadel_approval_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{decision}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Scrape targets up",
      "description": "Prometheus's own up metric. It is the only series that exists before a run produces a citadel_* sample, so an empty dashboard is distinguishable from a broken scrape.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Ingress refusals per minute",
      "description": "The expression CitadelRunRefusalsSustained evaluates, in per-minute units. The dashed threshold at 5 runs/min is the alert line: crossing it is not the alert, staying above it for 10m is.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "custom": {"drawStyle": "line", "lineWidth": 2, "thresholdsStyle": {"mode": "dashed"}},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 5}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(citadel_runs_refused_total[5m])) * 60",
          "legendFormat": "refusals/min"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Firing alerts",
      "description": "Prometheus' own ALERTS series for the rules it has loaded. Empty means nothing is firing; it carries the alert name only, never a tenant or a run.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Policy drift verdict",
      "description": "max(citadel_policy_drift): 1 means the last scheduled run compared the store with policy/model.fga, tools.json and the tuple set and found a difference. The second series is the run that could not compare (exit 2), which is neither drift nor clean, so a panel showing only the first would read a green 0 as healthy.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "never reported",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(citadel_policy_drift)",
          "legendFormat": "drift",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max(citadel_policy_drift_check_failed)",
          "legendFormat": "could not compare",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Drift check last run age",
      "description": "Seconds since the last verdict the host timer pushed. The timer runs hourly and CitadelPolicyDriftStale fires at two missed runs, so anything past an hour is already a missed run; 'never reported' is a timer that has not run at all.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "never reported",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 3600},
              {"color": "red", "value": 7200}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(citadel_policy_drift_last_run_timestamp_seconds)",
          "legendFormat": "last run",
          "instant": true
        }
      ]
    }
  ]
}
