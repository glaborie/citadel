# Placeholders only. Never commit real values. The real values live in the
# SOPS-encrypted secrets/citadel.env; see docs/security/secrets.md.

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_DEV_VALUE
KEYCLOAK_REALM=citadel
KEYCLOAK_CLIENT_ID=citadel-api

POSTGRES_USER=citadel
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEV_VALUE
POSTGRES_DB=citadel

TEMPORAL_NAMESPACE=default

OPENFGA_STORE_NAME=citadel

OMNIROUTE_URL=http://omniroute:20128/v1
OMNIROUTE_API_KEY=REPLACE_WITH_LOCAL_DEV_VALUE

# OmniRoute runtime secrets. Generate fresh values per host; never reuse them.
OMNIROUTE_JWT_SECRET=REPLACE_WITH_LOCAL_DEV_VALUE
OMNIROUTE_API_KEY_SECRET=REPLACE_WITH_LOCAL_DEV_VALUE
OMNIROUTE_STORAGE_ENCRYPTION_KEY=REPLACE_WITH_LOCAL_DEV_VALUE
OMNIROUTE_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_DEV_VALUE

# Model aliases. These are OmniRoute routing aliases: 'strong'/'fast'/'judge'
# are NOT valid model ids and return 400. auto/* may resolve to a different
# provider between calls, and OmniRoute reports the alias rather than the
# concrete model, so eval results pin the alias plus the provider from the
# x-omniroute-provider header.
MODEL_ALIAS_STRONG=auto/best-reasoning
MODEL_ALIAS_FAST=auto/best-fast
MODEL_ALIAS_JUDGE=auto/best-chat

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_ID=1
MLFLOW_EXPERIMENT_NAME=citadel-trajectories

# How much free text a trace may carry into MLflow: `summary` (default) keeps
# only lengths and digests, `none` sends no payload, `full` is an explicit
# opt-in for a development stack. Even in `full`, the task and the answer go
# through the DLP gate first: PII is redacted in place, a credential or an
# unreachable detector drops the field back to its summary form. Leave unset
# unless you are debugging and MLflow is not exposed beyond the host.
CITADEL_TRACE_CONTENT=

# No provider key belongs here in production; OmniRoute owns provider
# credentials in its SQLite store (see compose.yaml).

# Identity path (step 3). The app connects as citadel_app, never as the
# Postgres superuser, because superusers bypass row-level security.
CITADEL_DB_PASSWORD=REPLACE_WITH_LOCAL_DEV_VALUE

# Ed25519 keypair, base64 DER. The API holds the private key and mints run
# tokens; workers hold only the public key and can verify but never mint.
# The private key is mounted as a Docker secret (`<name>_FILE` in the service).
#   openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
CITADEL_RUN_TOKEN_PRIVATE_KEY=REPLACE_WITH_LOCAL_DEV_VALUE
CITADEL_RUN_TOKEN_PUBLIC_KEY=REPLACE_WITH_LOCAL_DEV_VALUE

# Password for the dev users created by scripts/bootstrap-identity.py.
CITADEL_DEV_PASSWORD=REPLACE_WITH_LOCAL_DEV_VALUE

# Seconds a pending approval stays usable before it auto-denies. Deployment
# wide: the API, the console and the workflow timeout must agree.
CITADEL_APPROVAL_TTL_SECONDS=300

# Serve the API's schema (/docs and /openapi.json). Off by default: the schema
# is a complete map of the attack surface and these paths answer without
# authentication. compose.yaml passes this to the api service (default false);
# set true/1/yes/on only where developers need it. /redoc is never served.
CITADEL_EXPOSE_API_DOCS=

# Host docker group id, so the operator service can use the socket as non-root.
DOCKER_GID=REPLACE_WITH_LOCAL_DEV_VALUE

# HS256 key for the approval console's session cookie. Any long random string;
# rotating it logs every console session out. Mounted as a Docker secret.
CITADEL_CONSOLE_SESSION_KEY=REPLACE_WITH_LOCAL_DEV_VALUE

# Bearer token for /metrics on the API and workers. `make up` generates one if
# SOPS does not set it, so this placeholder is an explicit local override only.
# Mounted as a Docker secret and read by Prometheus as bearer_token_file.
CITADEL_METRICS_TOKEN=REPLACE_WITH_LOCAL_DEV_VALUE

# Grafana admin password, mounted as a Docker secret and read by the service as
# a file. `make up` generates one if SOPS does not set it; read the value from
# secrets/grafana_admin_password to log in at http://localhost:13000.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_DEV_VALUE

# GitHub tokens, deliberately separate. Both are mounted as Docker secrets and
# reach the process that needs them as a file, never as a container env var.
#   GH_READ_TOKEN  -> mapped into the sandbox as GH_TOKEN (read-only, public)
#   GH_WRITE_TOKEN -> reserved for the operator; never exposed to the sandbox
GH_READ_TOKEN=REPLACE_WITH_LOCAL_DEV_VALUE
GH_WRITE_TOKEN=REPLACE_WITH_LOCAL_DEV_VALUE

# Repositories ingestion may read into a tenant's collection. The CLI selects
# from this set; it cannot widen it. Files under knowledge/ are mounted
# read-only and are the other source. Empty means no GitHub source.
CITADEL_INGEST_REPOS=

# Retrieval (v0.2). CITADEL_EMBEDDING_MODEL is an embedding alias or model id
# resolved by OmniRoute; empty disables dense vectors, so ingestion and query
# refuse rather than writing a chunk the hybrid search cannot find. ADR-025: the
# endpoint sees DLP-redacted text, never a credential. The reranker is the
# in-stack TEI service, so no document leaves the host for reranking.
CITADEL_EMBEDDING_MODEL=
CITADEL_RERANKER_URL=http://reranker:8080

# Model answer cache (v0.3, ADR-018). Entries are scoped by the full partition
# key and expire; nothing T1/T2 is cacheable. The similarity threshold is
# conservative by default and should be recalibrated with labelled pairs.
CITADEL_CACHE_TTL_SECONDS=3600
CITADEL_CACHE_SIMILARITY=0.95
